rules_version = '2';

// 角色存在 users/{uid}.role（'admin' | 'staff'）。
// 用 Firestore 文件查角色而唔係 email，避免改 email 就升權。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    // 使用者檔案：本人或管理員可讀；一律唔准由客端寫（只由種子腳本 / Admin SDK 寫）
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // 巡查紀錄
    match /inspections/{inspectionId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['floor', 'status', 'aiDetected', 'aiConfidence', 'aiEngine', 'photoPath', 'note', 'createdAt', 'createdBy']
           )
        && request.resource.data.floor is string
        && request.resource.data.floor.size() > 0
        && request.resource.data.floor.size() <= 20
        && request.resource.data.status == '待處理'
        && request.resource.data.aiDetected is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;

      // 只有管理員可以改，而且只准改狀態相關欄位
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['待處理', '已通知', '已結案'];

      allow delete: if false;
    }

    // 紙本通知
    match /notices/{noticeId} {
      allow read: if signedIn();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['inspectionId', 'floor', 'deadline', 'printedAt', 'createdBy'])
        && request.resource.data.floor is string
        && request.resource.data.deadline is string
        && request.resource.data.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.printedAt == request.time
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
